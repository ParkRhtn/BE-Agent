# 복사해서 .env 로 사용: cp .env.example .env

ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]

# 로컬 기본값: SQLite (Docker 불필요)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Postgres 사용 시 (docker compose up -d postgres)
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# "<provider>:<model>". fake:echo 는 API 키 없이 동작하는 개발용 모델
DEFAULT_MODEL=fake:echo
ALLOWED_MODELS=["fake:echo","anthropic:claude-sonnet-5","anthropic:claude-haiku-4-5-20251001","openai:gpt-5"]

# 제공사 API 키. 설정 화면에서 등록한 키가 없을 때만 쓰인다 (설정 화면 사용을 권장)
# 서버 키로 부른 모델은 운영자가 비용을 내므로, 공개 운영에서는 아래 CREDITS_ENFORCED=true 로 크레딧을 차감한다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 외부 API(/api/v1/ext/*): API 키 하나당 1분 요청 한도
EXT_RATE_LIMIT_PER_MINUTE=60
# 공개 링크(iframe): 링크 하나당 1분 요청 한도 (하루 한도는 링크마다 화면에서 정한다)
EMBED_RATE_LIMIT_PER_MINUTE=20

# 크레딧: 서버 키 모델 사용분만 실측 원가 기준으로 차감 (사용자가 등록한 키는 차감 안 함)
# false 면 차감 기록만 남기고 잔액이 없어도 막지 않는다 (로컬 개발용)
CREDITS_ENFORCED=false
# 원가 1 USD 당 차감 크레딧. 500 이면 1 크레딧 = 원가 $0.002 (약 3원). 판매 마진은 플랜 가격에서 붙인다
CREDITS_PER_USD=500
# 가입 시 체험 크레딧
SIGNUP_CREDITS=0
# 크레딧 충전·조정 API(/api/v1/admin/credits)를 쓸 수 있는 계정
ADMIN_EMAILS=[]

# MCP 서버 설정 (mcp_servers.example.json 참고)
# MCP_CONFIG_PATH=./mcp_servers.json

# Langfuse 추적 (선택)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 미국 리전 프로젝트면 https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 설정 화면에서 저장하는 제공사 API 키의 암호화 키. 없으면 JWT_SECRET 에서 만든다. 생성: openssl rand -hex 32
ENCRYPTION_KEY=

# 인증 (JWT). 생성: openssl rand -hex 32   — local 이 아닌 환경에서는 필수
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# 가입을 막으려면 false (첫 계정을 만든 뒤 끄면 개인용으로 쓰기 좋다)
ALLOW_SIGNUP=true

# 비밀번호 재설정 메일. SMTP_HOST 를 비워두면 메일 대신 서버 로그에 재설정 링크를 출력한다.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=주소, SMTP_PASSWORD=앱 비밀번호(2단계 인증 필요)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
