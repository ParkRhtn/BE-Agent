# 복사해서 .env 로 사용: cp .env.example .env

ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]

# 로컬 기본값: SQLite (Docker 불필요)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Postgres 사용 시 (docker compose up -d postgres)
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# "<provider>:<model>". fake:echo 는 API 키 없이 동작하는 개발용 모델
DEFAULT_MODEL=fake:echo
ALLOWED_MODELS=["fake:echo","anthropic:claude-sonnet-5","anthropic:claude-haiku-4-5-20251001","openai:gpt-5"]

# 제공사 API 키. 설정 화면에서 등록한 키가 없을 때만 쓰인다 (설정 화면 사용을 권장)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP 서버 설정 (mcp_servers.example.json 참고)
# MCP_CONFIG_PATH=./mcp_servers.json

# Langfuse 추적 (선택)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 미국 리전 프로젝트면 https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 설정 화면에서 저장하는 제공사 API 키의 암호화 키. 없으면 JWT_SECRET 에서 만든다. 생성: openssl rand -hex 32
ENCRYPTION_KEY=

# 인증 (JWT). 생성: openssl rand -hex 32   — local 이 아닌 환경에서는 필수
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# 가입을 막으려면 false (첫 계정을 만든 뒤 끄면 개인용으로 쓰기 좋다)
ALLOW_SIGNUP=true

# 비밀번호 재설정 메일. SMTP_HOST 를 비워두면 메일 대신 서버 로그에 재설정 링크를 출력한다.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=주소, SMTP_PASSWORD=앱 비밀번호(2단계 인증 필요)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
